generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?
  password  String   @default(uuid())
  status    String   @default("register")
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Users")
}

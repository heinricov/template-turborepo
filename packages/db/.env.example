# Environment untuk Prisma CLI (generate / push / studio) di package ini.
# Salin ke .env: cp .env.example .env
#
# Catatan penting:
# - File .env di sini HANYA dibaca oleh Prisma CLI (dotenv/config di
#   prisma.config.ts & prisma-pgsql.config.ts), BUKAN oleh API runtime.
# - Agar API memakai PostgreSQL saat jalan lokal, isi DATABASE_URL_PGSQL
#   di apps/api/.env atau export di shell (lihat Readme/development.md).

# SQLite (default lokal)
DATABASE_URL="file:./dev.db"

# PostgreSQL (opsional) — urutan prioritas yang dikenali:
#   DATABASE_URL_PGSQL > POSTGRES_URL > PRISMA_DATABASE_URL
# Contoh: postgres://user:pass@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL_PGSQL=""
